# Credentials for AI-generated session titles (src/main/agent/title-generator.ts).
# This model is used ONLY for title generation — kept isolated from whatever
# model the main agent/supervisor workflow ends up using. See
# prompts/ai-title-generation.md decision 8.
TITLE_GEN_BASE_URL=https://router.bynara.id/v1
TITLE_GEN_API_KEY=sk-your-key-here
TITLE_GEN_MODEL=nemotron-3-ultra-free

# Agent model endpoint (OpenAI-compatible) for the supervisor + desktop/browser/shell
# subagents. The model name is config.json's defaultModel (default: agnes-3-flash).
# Never passed to the MCP automation server's environment.
AGENT_BASE_URL=https://router.bynara.id/v1
AGENT_API_KEY=sk-your-key-here
