# Model providers are configured inside the app: Settings (gear icon) -> Model provider.
# There you choose OpenRouter, Nara Router or your own OpenAI-compatible provider and enter
# its base URL, API key and automation model. Keys are stored encrypted (Windows DPAPI).
#
# The variables below are only used:
#   - once, on first launch, to import your existing key into the app (it then lives in Settings), and
#   - as a fallback where no provider settings exist (tests, a bare dev run).
# Session titles are named automatically with a model the system chooses for the active
# provider; they are not configurable.

# Agent model endpoint (OpenAI-compatible). Never passed to the MCP automation server.
AGENT_BASE_URL=https://router.bynara.id/v1
AGENT_API_KEY=sk-your-key-here

# Optional fallback for AI-generated session titles (src/main/agent/title-generator.ts),
# used only when no provider with a key is configured.
TITLE_GEN_BASE_URL=https://router.bynara.id/v1
TITLE_GEN_API_KEY=sk-your-key-here
TITLE_GEN_MODEL=nemotron-3-ultra-free
