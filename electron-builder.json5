// Windows-only project — no mac/linux targets. Minimal packaging config
// from Stage 0: no icon or code signing yet, follow-up for a later stage.
{
  $schema: "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  appId: "ai.autonomous-desktop-agent",
  productName: "Autonomous AI Desktop Agent",
  directories: {
    output: "release",
  },
  files: ["dist", "dist-electron"],
  // The desktop/browser automation MCP server, compiled to a standalone exe by
  // `bun run build:mcp` (it needs Bun's bun:ffi, so it can't run inside Electron's Node).
  // Resolved at runtime by src/main/mcp/server-command.ts.
  extraResources: [{ from: "build/mcp-desktop.exe", to: "mcp-desktop.exe" }],
  win: {
    target: "nsis",
  },
}
